# Copy to .env and fill in for local development. NEVER commit .env.

# Flask session-signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Environment: development | testing | production
FLASK_ENV=development

# Optional: licensed Have I Been Pwned API key (the k-anonymity range
# endpoint used by this app works WITHOUT a key; this only raises limits).
HIBP_API_KEY=

# Maximum accepted password length (DoS guard).
MAX_PASSWORD_LENGTH=128
